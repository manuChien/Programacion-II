{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Compilar C",
      "command": "cmd",
      "args": [
        "/c",
        "gcc -Wall -Wextra -g *.c -o ${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}