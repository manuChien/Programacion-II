#include <stdio.h>
#include <stdlib.h>
#include "funciones.h"

Dqueue* copyDqueue(Dqueue* q)
{
    if(!q) return NULL;

    int queueSize = Dqueue_getsize(q);
    Dqueue* newQueue = Dqueue_new(queueSize);
    if(!newQueue) return NULL;

    for(int i=0; i<queueSize; i++)
    {
        DQUEUE_ELEM current = Ddequeue(q);
        Denqueue(newQueue,current);
        Denqueue(q,current);
    }

    return newQueue;
}
